{
  "name": "flightsimulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check:data": "node scripts/check-data.mjs",
    "check:panels": "esbuild scripts/check-panels.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/check-panels.mjs && node node_modules/.cache/check-panels.mjs",
    "seed": "esbuild scripts/seed.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/seed.mjs && node node_modules/.cache/seed.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "check:exercises": "esbuild scripts/check-exercises.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/check-exercises.mjs && node node_modules/.cache/check-exercises.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
